# ============================================================
# Portal SIMAK — Server Environment Variables
# ============================================================
# Salin file ini menjadi .env dan isi nilainya
# JANGAN commit file .env ke git

# --- Database ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/simak_db"

# --- Server ---
PORT=3001
NODE_ENV=development

# --- JWT ---
JWT_SECRET="ganti-dengan-string-rahasia-minimal-32-karakter"
JWT_EXPIRES_IN="8h"

# --- Enkripsi WBS (AES-256-GCM) ---
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WBS_ENCRYPTION_KEY="ganti-dengan-hex-64-karakter-hasil-crypto-randombytes-32"

# --- QR HMAC Secret ---
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_HMAC_SECRET="ganti-dengan-hex-64-karakter-hasil-crypto-randombytes-32"

# --- Email (SMTP) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="noreply@simak.ac.id"
SMTP_PASS="app-password-gmail"
EMAIL_FROM="SIMAK STIAMI <noreply@simak.ac.id>"

# --- Admin Default (seed) ---
ADMIN_EMAIL="admin@simak.ac.id"
ADMIN_PASSWORD="ganti-password-kuat"

# --- Frontend URL (CORS) ---
FRONTEND_URL="http://localhost:5173"
